DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"
JWT_SECRET="change-me-in-development"
PORT=3000

# Next.js storefront + admin origin (dev) — used for CORS.
WEB_URL="http://localhost:3001"

# Legacy Vite dev origins (kept for the old client/admin if still running).
CLIENT_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# Cloudinary (optional). When unset, product images fall back to their source URL.
# Single-URL form: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""
