# Production build config for the Vercel-hosted Next.js app.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time — PUBLIC, not secret.
# Points the storefront/admin at the Render-hosted NestJS API (service name: gmc-eccomerce-api).
NEXT_PUBLIC_API_URL="https://gmc-eccomerce-api.onrender.com/api"
